# Create Fama-French factors using ONLY stock data
def create_ff_factors(stock_returns_df, stock_symbols):
    """
    Create Fama-French factor proxies from PURE stock universe (no crypto contamination)
    """
    import yfinance as yf
    import pandas as pd
    import numpy as np

    # -------------------------------------------------
    # Ensure we're working with stock data only
    # -------------------------------------------------
    stock_returns = stock_returns_df[stock_symbols]

    # Market factor (Rm-Rf): Use equal-weighted STOCK portfolio as market proxy
    market_return = stock_returns.mean(axis=1)

    # Risk-free rate proxy: Use 0.02/365 (2% annual rate for daily data)
    risk_free_rate = 0.02 / 365
    market_excess = market_return - risk_free_rate

      # -------------------------------------------------
    # SMB (Small Minus Big): TRUE Size factor by Market Capitalization
    # -------------------------------------------------
    mcap = {}
    for sym in stock_symbols:
        tkr = yf.Ticker(sym)
        try:
            # Προσπάθησε γρήγορα: fast_info
            fi = getattr(tkr, "fast_info", {})
            cap = fi.get("market_cap") or fi.get("marketCap")
        except Exception:
            cap = None
        if not cap:
            # Fallback σε info ή σε sharesOutstanding*τελευταία τιμή
            try:
                info = getattr(tkr, "info", {})
                cap = info.get("marketCap")
                if not cap and info.get("sharesOutstanding"):
                    last = tkr.history(period="3mo")["Close"].dropna()
                    if not last.empty:
                        cap = float(info["sharesOutstanding"]) * float(last.iloc[-1])
            except Exception:
                cap = None
        if cap and cap > 0:
            mcap[sym] = cap

    mcap = pd.Series(mcap).dropna()

    if len(mcap) >= 2:
        small_caps = mcap.nsmallest(len(mcap)//2).index  # “Small”
        big_caps   = mcap.nlargest(len(mcap)//2).index   # “Big”
        smb = stock_returns[small_caps].mean(axis=1) - stock_returns[big_caps].mean(axis=1)
    else:
        # Αν δεν βρεθούν αρκετά στοιχεία, κράτα ουδέτερο factor
        smb = pd.Series(0.0, index=stock_returns.index)


# -------------------------------------------------
    # HML (High Minus Low): TRUE Value factor (Book-to-Market)
    # -------------------------------------------------
    def _pick_row(df, names):
        if df is None or (isinstance(df, pd.DataFrame) and df.empty):
            return pd.Series(dtype=float)
        for n in names:
            if n in df.index:
                s = df.loc[n].dropna()
                if not s.empty:
                    return s.sort_index()
        return pd.Series(dtype=float)

    bm = {}
    for sym in stock_symbols:
        tkr = yf.Ticker(sym)

        # ---- Book Equity from balance sheet (quarterly -> annual; fallbacks) ----
        bs_q = getattr(tkr, "quarterly_balance_sheet", pd.DataFrame())
        bs_a = getattr(tkr, "balance_sheet", pd.DataFrame())
        bs = bs_q if bs_q is not None and not bs_q.empty else bs_a
        if bs is None or bs.empty:
            continue

        equity = _pick_row(bs, [
            "Total Stockholder Equity",
            "Total Stockholders' Equity",
            "Total Equity Gross Minority Interest"
        ])
        if equity.empty:
            assets = _pick_row(bs, ["Total Assets", "Total assets", "TotalAssets"])
            liab   = _pick_row(bs, ["Total Liab", "Total Liabilities", "Total liabilities"])
            if assets.empty or liab.empty:
                continue
            a, l = assets.align(liab, join="inner")
            eq_series = (a - l).dropna()
            if eq_series.empty:
                continue
            be = float(eq_series.iloc[-1])
        else:
            be = float(equity.dropna().iloc[-1])

        if be <= 0:
            continue

        # ---- Market Cap (fast_info -> info -> shares*price fallback) ----
        mcap = None
        try:
            fi = getattr(tkr, "fast_info", {})
            mcap = fi.get("market_cap") or fi.get("marketCap")
        except Exception:
            mcap = None
        if not mcap:
            try:
                info = getattr(tkr, "info", {})
                mcap = info.get("marketCap")
                if not mcap and info.get("sharesOutstanding"):
                    last = tkr.history(period="3mo")["Close"].dropna()
                    if not last.empty:
                        mcap = float(info["sharesOutstanding"]) * float(last.iloc[-1])
            except Exception:
                mcap = None

        if not mcap or mcap <= 0:
            continue

        bm[sym] = be / float(mcap)

    bm = pd.Series(bm).dropna()

    if len(bm) >= 2:
        high_bm = bm.nlargest(len(bm) // 2).index   # VALUE (high B/M)
        low_bm  = bm.nsmallest(len(bm) // 2).index  # GROWTH (low B/M)
        hml = stock_returns[high_bm].mean(axis=1) - stock_returns[low_bm].mean(axis=1)
    else:
        # αν δεν υπάρχουν αρκετά δεδομένα, κράτα ουδέτερο HML
        hml = pd.Series(0.0, index=stock_returns.index)

    # -------------------------------------------------
    # RMW (Robust Minus Weak): Profitability factor
    # -------------------------------------------------
    def _get_first_nonempty_row(df, names):
        if df is None or (isinstance(df, pd.DataFrame) and df.empty):
            return pd.Series(dtype=float)
        for n in names:
            if n in df.index:
                s = df.loc[n].dropna()
                if not s.empty:
                    return s.sort_index()
        return pd.Series(dtype=float)

    prof = {}
    for sym in stock_symbols:
        tkr = yf.Ticker(sym)

        # Income statement: δοκίμασε quarterly -> annual -> νέα ονόματα API
        inc = getattr(tkr, "quarterly_financials", pd.DataFrame())
        if inc is None or inc.empty:
            inc = getattr(tkr, "financials", pd.DataFrame())
        if (inc is None or inc.empty) and hasattr(tkr, "quarterly_income_stmt"):
            inc = getattr(tkr, "quarterly_income_stmt")
        if (inc is None or inc.empty) and hasattr(tkr, "income_stmt"):
            inc = getattr(tkr, "income_stmt")

        # Balance sheet: quarterly -> annual
        bs = getattr(tkr, "quarterly_balance_sheet", pd.DataFrame())
        if bs is None or bs.empty:
            bs = getattr(tkr, "balance_sheet", pd.DataFrame())

        if inc is None or bs is None or inc.empty or bs.empty:
            continue

        # Προσπάθησε Operating Income, αλλιώς Gross Profit (Novy-Marx fallback)
        op_inc = _get_first_nonempty_row(inc, [
            "Operating Income", "Operating Income (Loss)", "EBIT"
        ])
        gross_profit = _get_first_nonempty_row(inc, ["Gross Profit", "GrossProfit"]) if op_inc.empty else pd.Series(dtype=float)

        # Assets / Liabilities / Equity
        total_assets = _get_first_nonempty_row(bs, ["Total Assets", "Total assets", "TotalAssets"])
        total_liab   = _get_first_nonempty_row(bs, ["Total Liab", "Total Liabilities", "Total liabilities"])
        if total_assets.empty:
            continue

        equity_explicit = _get_first_nonempty_row(bs, [
            "Total Stockholder Equity", "Total Stockholders' Equity", "Total Equity Gross Minority Interest"
        ])
        if equity_explicit.empty and not total_liab.empty:
            a, l = total_assets.align(total_liab, join="inner")
            equity_series = (a - l).dropna()
        else:
            equity_series = equity_explicit.dropna()

        # Επιλέγουμε παρονομαστή: Equity αν υπάρχει, αλλιώς Assets (για ROA/gross profitability)
        if not equity_series.empty:
            denom = float(equity_series.iloc[-1])
            if denom == 0:
                continue
        else:
            denom = float(total_assets.dropna().iloc[-1])
            if denom == 0:
                continue

        # Υπολόγισε profitability
        if not op_inc.empty:
            numer = float(op_inc.dropna().iloc[-1])
            prof_val = numer / denom
        elif not gross_profit.empty:
            numer = float(gross_profit.dropna().iloc[-1])
            # Gross profitability ορίζεται πάνω στα Assets
            prof_val = numer / float(total_assets.dropna().iloc[-1])
        else:
            continue

        if np.isfinite(prof_val):
            prof[sym] = prof_val

    prof = pd.Series(prof).dropna()

    if len(prof) >= 2:
        half = len(prof) // 2
        robust_stocks = prof.nlargest(half).index
        weak_stocks   = prof.nsmallest(half).index
        rmw = stock_returns[robust_stocks].mean(axis=1) - stock_returns[weak_stocks].mean(axis=1)
    else:
        # Αν ακόμη δεν υπάρχουν αρκετά στοιχεία, κράτα ουδέτερο factor (για να μη “σπάει” η παλινδρόμηση)
        rmw = pd.Series(0.0, index=stock_returns.index)

    print(f"RMW: profitability διαθέσιμο για {len(prof)}/{len(stock_symbols)} tickers.")

    # -------------------------------------------------
    # CMA (Conservative Minus Aggressive): low asset-growth minus high asset-growth
    # -------------------------------------------------
    def get_asset_growth(symbol):
        tkr = yf.Ticker(symbol)
        bs = tkr.quarterly_balance_sheet
        if bs is None or bs.empty or 'Total Assets' not in bs.index:
            return None
        s = bs.loc['Total Assets'].sort_index()
        if len(s) < 2:
            return None
        return (s.iloc[-1] - s.iloc[-2]) / s.iloc[-2]

    growth = {sym: get_asset_growth(sym) for sym in stock_symbols}
    growth = pd.Series(growth).dropna()

    low_inv  = growth.nsmallest(len(growth)//2).index
    high_inv = growth.nlargest(len(growth)//2).index

    cma = stock_returns[low_inv].mean(axis=1) - stock_returns[high_inv].mean(axis=1)

    # -------------------------------------------------
    # Combine factors into DataFrame
    # -------------------------------------------------
    factors = pd.DataFrame({
        'Mkt-RF': market_excess,
        'SMB':    smb,
        'HML':    hml,
        'RMW':    rmw,
        'CMA':    cma
    }, index=stock_returns.index)

    return factors, risk_free_rate

# Create Fama-French factors using only stock data
