def create_robust_stock_factors(stock_returns_df, stock_symbols):
    """
    Create robust Fama-French factors with corrections:
    - Mkt-RF: mean stock return minus risk-free rate
    - SMB: Small Minus Big, based on market capitalization (size)
    - HML: High Minus Low, based on Book-to-Market ratio
    """
    print(f"\n🔧 Creating robust stock factors:")
    stock_returns = stock_returns_df[stock_symbols].dropna()

    if len(stock_returns) < 100:
        print("⚠️ Not enough data for factors")
        return None, None

    # ---- Correction 1: Risk-free scaling ----
    # Use 0.02 annual ≈ 2% → convert to daily (trading days = 252, not 365)
    risk_free_rate = 0.02 / 252

    # ---- Correction 2: Market Factor (Mkt-RF) ----
    market_return = stock_returns.mean(axis=1)
    market_excess = market_return - risk_free_rate
    print(f"   Market: mean={market_excess.mean():.4f}, std={market_excess.std():.4f}")

    # ---- Correction 3: SMB (Size) ----
    # Based on market capitalization, not volatility
    import yfinance as yf
    mcap = {}
    for sym in stock_symbols:
        tkr = yf.Ticker(sym)
        try:
            cap = getattr(tkr, "fast_info", {}).get("market_cap")
            if not cap:
                cap = tkr.info.get("marketCap")
        except Exception:
            cap = None
        if cap:
            mcap[sym] = cap

    mcap = pd.Series(mcap).dropna()
    if len(mcap) >= 2:
        small = mcap.nsmallest(len(mcap)//2).index
        big   = mcap.nlargest(len(mcap)//2).index
        smb = stock_returns[small].mean(axis=1) - stock_returns[big].mean(axis=1)
    else:
        smb = pd.Series(0.0, index=stock_returns.index)
    print(f"   SMB: mean={smb.mean():.4f}, std={smb.std():.4f}")

    # ---- Correction 4: HML (Value) ----
    # Book-to-Market instead of momentum proxy
    def _pick_row(df, names):
        if df is None or df.empty: return pd.Series(dtype=float)
        for n in names:
            if n in df.index:
                return df.loc[n].dropna().sort_index()
        return pd.Series(dtype=float)

    bm = {}
    for sym in stock_symbols:
        tkr = yf.Ticker(sym)
        bs = tkr.balance_sheet
        if bs is None or bs.empty: continue
        eq = _pick_row(bs, ["Total Stockholder Equity", "Total Stockholders' Equity"])
        assets = _pick_row(bs, ["Total Assets"])
        liab   = _pick_row(bs, ["Total Liab"])
        if eq.empty and not assets.empty and not liab.empty:
            eq = (assets - liab).dropna()
        if eq.empty: continue
        try:
            be = float(eq.iloc[-1])
            cap = mcap.get(sym, None)
            if be > 0 and cap and cap > 0:
                bm[sym] = be / cap
        except: continue

    bm = pd.Series(bm).dropna()
    if len(bm) >= 2:
        high = bm.nlargest(len(bm)//2).index
        low  = bm.nsmallest(len(bm)//2).index
        hml = stock_returns[high].mean(axis=1) - stock_returns[low].mean(axis=1)
    else:
        hml = pd.Series(0.0, index=stock_returns.index)
    print(f"   HML: mean={hml.mean():.4f}, std={hml.std():.4f}")

    # Combine corrected factors
    factors = pd.DataFrame({
        "Mkt-RF": market_excess,
        "SMB": smb,
        "HML": hml
    }, index=stock_returns.index)

    return factors, risk_free_rate


def create_robust_crypto_factors(crypto_returns_df, crypto_symbols):
    """
    Create robust crypto factors with corrections:
    - BTC_Market: BTC as benchmark
    - Size: vol-based proxy (since market cap data unavailable in synthetic)
    - Momentum: rolling cumulative return
    """
    print(f"\n🚀 Creating robust crypto factors:")
    crypto_returns = crypto_returns_df[crypto_symbols].dropna()

    # BTC Market Factor
    if "BTC" not in crypto_returns.columns:
        print("⚠️ No BTC found")
        return None
    btc = crypto_returns["BTC"]
    print(f"   BTC Market: mean={btc.mean():.4f}, std={btc.std():.4f}")

    # Size proxy: high vol vs low vol
    vol = crypto_returns.rolling(30).std().iloc[-1].dropna()
    if len(vol) >= 2:
        small = vol.nlargest(len(vol)//2).index
        big   = vol.nsmallest(len(vol)//2).index
        size = crypto_returns[small].mean(axis=1) - crypto_returns[big].mean(axis=1)
    else:
        size = pd.Series(0.0, index=crypto_returns.index)

    # Momentum proxy: 20-day cumulative return
    cumret = crypto_returns.rolling(20).sum().iloc[-1].dropna()
    if len(cumret) >= 2:
        winners = cumret.nlargest(len(cumret)//2).index
        losers  = cumret.nsmallest(len(cumret)//2).index
        momentum = crypto_returns[winners].mean(axis=1) - crypto_returns[losers].mean(axis=1)
    else:
        momentum = pd.Series(0.0, index=crypto_returns.index)

    factors = pd.DataFrame({
        "BTC_Market": btc,
        "Size": size,
        "Momentum": momentum
    }, index=crypto_returns.index)

    return factors


